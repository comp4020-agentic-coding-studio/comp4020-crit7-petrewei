{
  "permissions": {
    "ask": [
      "Edit(/spec/**)",
      "Edit(/.github/workflows/**)",
      "Edit(/src/data/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/lint-markdown.sh"
          }
        ]
      }
    ]
  }
}
