node_modules/
dist/
.astro/
*.log

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini

# the local dev database — state on your machine, never in the repo
.data/

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem

# Claude Code's project directory is machine-local apart from the shared
# harness: settings.json (permission rules and hooks) and hooks/. The course
# API key lives in settings.local.json, which stays ignored with everything
# else here, and the pre-commit hook blocks sk- keys as a second guard.
.claude/*
!.claude/settings.json
!.claude/hooks/
