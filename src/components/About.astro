---
// A README rendered as the About page: README.md in English and
// README.zh-CN.md in Chinese, published with the app. spec/readme.test.ts and
// spec/i18n.test.ts check the whole of each is there.
import type { MarkdownInstance } from "astro";
import { type Locale, STRINGS } from "../lib/i18n";
import Header from "./Header.astro";
import "../styles.css";

const { locale, readme } = Astro.props as { locale: Locale; readme: MarkdownInstance<Record<string, never>> };

const title = readme.getHeadings().find((h) => h.depth === 1)?.text ?? "README";

// README images are committed to public/ and linked relatively (public/x.png)
// so they render on GitHub; here they're served from the site root.
const html = (await readme.compiledContent()).replace(/(src|href)="public\//g, '$1="/');
---

<!doctype html>
<html lang={STRINGS[locale].lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <Header locale={locale} />
    <main class="prose" set:html={html} />
  </body>
</html>
