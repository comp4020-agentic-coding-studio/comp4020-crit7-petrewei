---
import Header from "../components/Header.astro";
import { isOneOff } from "../lib/clash";
import { loadTimetable, weekView } from "../lib/timetable";
import "../styles.css";

const { choosable, commitments } = loadTimetable();
const week = weekView(commitments, Astro.url.searchParams.get("week"));

const freeText = (free: number | null): string =>
  free === null ? "" : free === 0 ? "Full" : `${free} ${free === 1 ? "place" : "places"} free`;

const datesText = (weeks: string): string => (isOneOff(weeks) ? `${weeks} only` : weeks.replaceAll("-", "–"));

// A card shows a group's regular times. A makeup, such as a tutorial moved
// for a public holiday, is listed only in the details.
const isMakeup = (meeting: { type: string }): boolean => meeting.type.endsWith("Makeup");
const regular = <M extends { type: string }>(meetings: M[]): M[] => meetings.filter((m) => !isMakeup(m));
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ANU Timetable</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <Header />
    <main>
      <h1>Second Semester 2026</h1>
      <p class="lede">Your lab and tutorial groups, and your classes one week at a time; clashes are marked red in the week.</p>

      <div class="activities">
        {
          choosable.map((activity) => (
            <section class="activity" data-activity={activity.id} aria-labelledby={`heading-${activity.id}`}>
              <h2 id={`heading-${activity.id}`}>
                {activity.courseCode} {activity.kind}
              </h2>
              <p class="course">{activity.courseTitle}</p>
              <form method="post" action="/api/allocation">
                <input type="hidden" name="activity" value={activity.id} />
                <input type="hidden" name="week" value={week.number} />
                <ul class="groups">
                  {activity.groups.map((group) => (
                    <li
                      class="card"
                      data-group={group.id}
                      data-allocated={group.allocated ? "" : undefined}
                    >
                      <div class="card-head">
                        <span class="group-name">Group {group.label}</span>
                        <button
                          name="group"
                          value={group.label}
                          disabled={group.allocated}
                          aria-label={group.allocated ? `Group ${group.label} is allocated` : `Allocate group ${group.label}`}
                        >
                          {group.allocated ? "Allocated" : "Allocate"}
                        </button>
                      </div>
                      {regular(group.meetings).map((meeting) => (
                        <p class="when">
                          {meeting.day} {meeting.start}–{meeting.end}
                        </p>
                      ))}
                      <p class:list={["free", { full: group.free === 0 }]}>{freeText(group.free)}</p>
                      <details>
                        <summary>Details</summary>
                        <ul class="meetings">
                          {group.meetings.map((meeting) => (
                            <li>
                              <span class="meeting-type">
                                {meeting.type} {meeting.activity}
                              </span>
                              <span>
                                {isMakeup(meeting) && `${meeting.day} ${meeting.start}–${meeting.end}, `}
                                {datesText(meeting.weeks)}
                              </span>
                              <span>{meeting.location}</span>
                            </li>
                          ))}
                        </ul>
                      </details>
                    </li>
                  ))}
                </ul>
              </form>
            </section>
          ))
        }
      </div>

      <section class="week-section" aria-labelledby="heading-week" data-week={week.number}>
        <h2 id="heading-week">Your week</h2>
        <p class="course">
          Your lectures and allocated tutorial and lab groups, on the dates they meet. A meeting marked
          "clash" overlaps another on the same date.
        </p>
        <nav class="week-nav" aria-label="weeks">
          {week.prev ? <a href={`/?week=${week.prev}`} rel="prev">Previous week</a> : <span />}
          <span class="week-range">
            Week {week.number}: {week.days[0].day} {week.days[0].date} to {week.days[4].day} {week.days[4].date}
          </span>
          {week.next ? <a href={`/?week=${week.next}`} rel="next">Next week</a> : <span />}
        </nav>
        <div class="week">
          {
            week.days.map(({ day, date, entries }) => (
              <div class="day" data-date={date}>
                <h3>
                  {day} {date}
                </h3>
                <ul>
                  {entries.length === 0 && <li class="slot-empty">Nothing on</li>}
                  {entries.map((entry) => (
                    <li data-slot={entry.key} class:list={{ choosable: entry.choosable, "slot-clash": entry.clash }}>
                      <span class="slot-time">
                        {entry.meeting.start}–{entry.meeting.end}
                      </span>
                      <span class="slot-title">{entry.title}</span>
                      <span class="slot-where">{entry.meeting.location}</span>
                      {entry.meeting.staff && <span class="slot-where">{entry.meeting.staff}</span>}
                      {isMakeup(entry.meeting) && <span class="slot-note">{entry.meeting.type}</span>}
                      {entry.clash && <span class="slot-note slot-clash-note">clash</span>}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>
    </main>
  </body>
</html>
